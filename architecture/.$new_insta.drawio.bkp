  <diagram id="NxShhOe3HQ0nsaTJBtKU" name="Requirement">
    <mxGraphModel dx="1205" dy="483" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ZKyDycDu-kquMqPA_Ag0-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Total user = 100k users at EU-West&lt;/div&gt;&lt;div&gt;Avg Requests per User per Day = Loading Feed (~100 req) + Upload image (~2 req) + User Engagement (like posts, comments) (~40 req) = 140&lt;/div&gt;&lt;div&gt;DAU = 30k&lt;/div&gt;&lt;div&gt;Total Requests per Day = 140 * 30 = 4200&lt;/div&gt;&lt;div&gt;RPS = (DAU × Avg Requests per User per Day) / 86,400 = 49&lt;/div&gt;&lt;div&gt;QPS = todo&lt;/div&gt;&lt;div&gt;WPS = RPS × Write Percentage = 49 * 0.2 = 10&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Feature:&lt;/div&gt;&lt;div&gt;1. Register/Login&lt;/div&gt;&lt;div&gt;2. Upload/Remove posts(with caption)&lt;/div&gt;&lt;div&gt;3. Like/Comment, view likes/comments count&lt;/div&gt;&lt;div&gt;4. Home feed&amp;nbsp;&lt;/div&gt;&lt;div&gt;5. Follow/Unfollow&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="830" x="-400" y="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
