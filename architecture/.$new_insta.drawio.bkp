        <mxCell id="DfTsoFPleP0puCORA56l-5" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=52.5;entryPerimeter=0;" target="xl4eEDG6ZP3Kq7yJZ1V7-1" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="650" y="400" as="sourcePoint" />
            <mxPoint x="720" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nvpttP2-8zL2qfcNgfX_-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;&lt;font&gt;Redis:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Purpose of Redis for feed: avoiding fetch from DB again&amp;nbsp;&lt;br&gt;Use Redis for fetching feed:&lt;br&gt;- When user request posts, search in cache, if miss, fetch from DB&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="340" x="400" y="890" as="geometry" />
        </mxCell>
        <mxCell id="nvpttP2-8zL2qfcNgfX_-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="How to generate feed:&lt;br&gt;- Fetch all feed from all accounts that user follows. Take newest post of each following account (limit to 10 posts for a feed).&lt;br&gt;Note: for simplicity, we just have 10 posts by feed, there is no auto refill when scroll down yet." vertex="1">
          <mxGeometry height="120" width="260" x="880" y="930" as="geometry" />
        </mxCell>
        <mxCell id="hWwLj9Hi7J5zO2DEE8ou-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Note:&lt;/b&gt;&lt;br&gt;- Redis and server should be in same region (to avoid unnecessary cross-region latency)" vertex="1">
          <mxGeometry height="140" width="270" x="1020" y="660" as="geometry" />
        </mxCell>
        <mxCell id="pHBi6SKbmzJpZ3_SduDp-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;CREATE INDEX idx_posts_user_latest&amp;nbsp;&lt;/div&gt;&lt;div&gt;ON posts (user_id, created_at DESC);&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="240" x="880" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="3A2HDN7Hxb6nGVxtUF1j-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;SELECT *&lt;/div&gt;&lt;div&gt;FROM (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; SELECT DISTINCT ON (p.author_id)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; p.&quot;Id&quot; AS post_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; p.author_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; p.caption,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; p.media_url,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; p.created_at,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SELECT COUNT(*)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FROM &quot;Comments&quot; c&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHERE c.post_id = p.&quot;Id&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ) AS comment_count&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FROM &quot;Posts&quot; p&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; JOIN &quot;Follows&quot; f ON p.author_id = f.following_id&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; WHERE f.follower_id = &#39;CURRENT_USER_ID&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ORDER BY p.author_id, p.created_at DESC&lt;/div&gt;&lt;div&gt;) latest_posts&lt;/div&gt;&lt;div&gt;ORDER BY created_at DESC&lt;/div&gt;&lt;div&gt;LIMIT 10;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="270" x="1220" y="820" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="0rJTfK4R6BrygSkSL3FX" name="Milestones">
    <mxGraphModel dx="729" dy="716" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="P_78HRs9DoCAfN91wDVU-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3 data-path-to-node=&quot;7&quot;&gt;Milestone 1: 100k Users (~10k DAU)&lt;/h3&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Architecture:&lt;/b&gt; Monolithic API, single PostgreSQL DB, basic Redis for session/cache-aside, CDN for images.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The Main Bottleneck:&lt;/b&gt; Database CPU spikes if users hit the same feed queries repeatedly.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot;&gt;The Fix:&lt;/b&gt; Add proper database indexes, set up a basic Redis cache-aside layer, and serve media through a CDN.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-path-to-node=&quot;10&quot;&gt;Milestone 2: 1M Users (~100k–150k DAU)&lt;/h3&gt;&lt;ul data-path-to-node=&quot;11&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,0,0&quot;&gt;&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Architecture:&lt;/b&gt; Monolith or light Microservices, PostgreSQL with &lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;63&quot;&gt;Read Replicas&lt;/b&gt;, dedicated Background Queue (RabbitMQ / BullMQ), Redis for active feed caching.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,1,0&quot;&gt;&lt;b data-path-to-node=&quot;11,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The Main Bottleneck:&lt;/b&gt; Read traffic overwhelms the single primary database, and long tasks (like video/image processing) slow down API request threads.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,2,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,0&quot; data-index-in-node=&quot;0&quot;&gt;The Fix:&lt;/b&gt;&lt;/p&gt;&lt;ol start=&quot;1&quot; data-path-to-node=&quot;11,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,2,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Read Replicas:&lt;/b&gt; Send all &lt;code data-path-to-node=&quot;11,2,1,0,0&quot; data-index-in-node=&quot;24&quot;&gt;SELECT&lt;/code&gt; queries to Read Replicas and keep the Primary DB strictly for &lt;code data-path-to-node=&quot;11,2,1,0,0&quot; data-index-in-node=&quot;93&quot;&gt;INSERT/UPDATE&lt;/code&gt; writes.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,2,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Asynchronous Queues:&lt;/b&gt; Move image resizing, notifications, and email triggers completely off the main thread into background queue workers.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,2,1,2,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,1,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Connection Pooling:&lt;/b&gt; Use PgBouncer to prevent thousands of open database connections from eating up RAM.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-path-to-node=&quot;13&quot;&gt;Milestone 3: 5M Users (~500k–750k DAU)&lt;/h3&gt;&lt;ul data-path-to-node=&quot;14&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,0,0&quot;&gt;&lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Architecture:&lt;/b&gt; Distributed Microservices, &lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;41&quot;&gt;Sharded Databases&lt;/b&gt; / NoSQL (Cassandra/DynamoDB), Kafka Event Streaming, Hybrid Push/Pull Feed Fanout.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,1,0&quot;&gt;&lt;b data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The Main Bottleneck:&lt;/b&gt; The Primary Database can no longer handle the sheer volume of &lt;b data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;83&quot;&gt;write operations&lt;/b&gt; (millions of likes, comments, posts per day). A single Redis instance runs out of RAM.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,0&quot;&gt;&lt;b data-path-to-node=&quot;14,2,0&quot; data-index-in-node=&quot;0&quot;&gt;The Fix:&lt;/b&gt;&lt;/p&gt;&lt;ol start=&quot;1&quot; data-path-to-node=&quot;14,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;14,2,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Database Sharding:&lt;/b&gt; Split the database horizontally across multiple servers (e.g., User IDs 1–1M on DB Shard 1, User IDs 1M–2M on DB Shard 2).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;14,2,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Redis Clusters:&lt;/b&gt; Shard Redis memory across multiple instances.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,1,2,0&quot;&gt;&lt;b data-path-to-node=&quot;14,2,1,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Event-Driven Feed Architecture:&lt;/b&gt; Use message streaming (Kafka) with background workers to handle complex feed fanout logic.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="630" width="700" x="40" y="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uw4TudZDsq3-d3h6YfiK" name="Testing">
    <mxGraphModel dx="606" dy="665" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="D0rAHgWxylfIHYmlHowt-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;-- Enable UUID extension (Required for Postgres versions &amp;lt; 13)&lt;/div&gt;&lt;div&gt;CREATE EXTENSION IF NOT EXISTS &quot;pgcrypto&quot;;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;-- 1. Clean up existing load test data&lt;/b&gt;&lt;/div&gt;&lt;div&gt;TRUNCATE TABLE &quot;Likes&quot;, &quot;Comments&quot;, &quot;Follows&quot;, &quot;Posts&quot;, &quot;Users&quot; CASCADE;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;-- 2. Seed Users (1,000 users with generated UUIDs)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;INSERT INTO &quot;user_account&quot; (user_id, username, password_hash, avatar_url)&lt;/div&gt;&lt;div&gt;SELECT&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; gen_random_uuid(),&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-- Generates a random v4 UUID&lt;/div&gt;&lt;div&gt;&amp;nbsp; &#39;user_&#39; || g,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &#39;hashed_password_sample&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &#39;https://avatar.url/sample.png&#39;&lt;/div&gt;&lt;div&gt;FROM generate_series(1, 1000) AS g;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;-- 3. Seed Follows (Each user follows ~10 random users)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;INSERT INTO &quot;follows&quot; (follower_id, following_id, created_at)&lt;/div&gt;&lt;div&gt;SELECT&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; f.user_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; target.user_id,&lt;/div&gt;&lt;div&gt;&amp;nbsp; NOW() - (random() * interval &#39;30 days&#39;)&lt;/div&gt;&lt;div&gt;FROM &quot;user_account&quot; f&lt;/div&gt;&lt;div&gt;CROSS JOIN LATERAL (&lt;/div&gt;&lt;div&gt;&amp;nbsp; SELECT user_id FROM &quot;user_account&quot; WHERE user_id != f.user_id ORDER BY random() LIMIT 10&lt;/div&gt;&lt;div&gt;) target&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ON CONFLICT DO NOTHING;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-- 4. Seed Posts (5,000 posts assigned to random users)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;WITH users AS (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; SELECT array_agg(user_id) AS ids&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FROM &quot;user_account&quot;&lt;/div&gt;&lt;div&gt;)&lt;/div&gt;&lt;div&gt;INSERT INTO &quot;posts&quot; (id, author_id, caption, media_url, created_at)&lt;/div&gt;&lt;div&gt;SELECT&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; gen_random_uuid(),&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ids[1 + floor(random() * array_length(ids, 1))::int],&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39;Sample caption &#39; || g,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &#39;https://media.url/photo.jpg&#39;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; NOW() - random() * interval &#39;7 days&#39;&lt;/div&gt;&lt;div&gt;FROM users,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;generate_series(1, 5000) AS g;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="630" width="500" x="150" y="130" as="geometry" />
        </mxCell>
        <mxCell id="R6opoI9OSAmfo4zmLTgN-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3 data-start=&quot;742&quot; data-end=&quot;779&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Feed endpoint (most important)&lt;/h3&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;781&quot; data-end=&quot;798&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;GET /feed&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;800&quot; data-end=&quot;807&quot;&gt;Target:&lt;/p&gt;&lt;ul data-start=&quot;809&quot; data-end=&quot;838&quot;&gt;&lt;li data-start=&quot;809&quot; data-end=&quot;818&quot;&gt;100 RPS&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;819&quot; data-end=&quot;828&quot;&gt;200 RPS&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;829&quot; data-end=&quot;838&quot;&gt;300 RPS&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;840&quot; data-end=&quot;848&quot;&gt;Measure:&lt;/p&gt;&lt;ul data-start=&quot;850&quot; data-end=&quot;914&quot;&gt;&lt;li data-start=&quot;850&quot; data-end=&quot;863&quot;&gt;P95 latency&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;864&quot; data-end=&quot;884&quot;&gt;SQL execution time&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;885&quot; data-end=&quot;890&quot;&gt;CPU&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;891&quot; data-end=&quot;914&quot;&gt;connection pool usage&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;916&quot; data-end=&quot;945&quot;&gt;If feed is slow, investigate:&lt;/p&gt;&lt;ul data-start=&quot;947&quot; data-end=&quot;1010&quot;&gt;&lt;li data-start=&quot;947&quot; data-end=&quot;964&quot;&gt;Missing indexes&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;965&quot; data-end=&quot;978&quot;&gt;N+1 queries&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;979&quot; data-end=&quot;992&quot;&gt;Large joins&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;993&quot; data-end=&quot;1010&quot;&gt;Poor pagination&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;h2 data-start=&quot;1460&quot; data-end=&quot;1477&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Mixed workload&lt;/h2&gt;&lt;br&gt;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;1554&quot; data-end=&quot;1692&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;1554&quot; data-end=&quot;1579&quot;&gt;&lt;tr data-start=&quot;1554&quot; data-end=&quot;1579&quot;&gt;&lt;th data-start=&quot;1554&quot; data-end=&quot;1565&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Endpoint&lt;/th&gt;&lt;th data-start=&quot;1565&quot; data-end=&quot;1579&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Percentage&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;1606&quot; data-end=&quot;1692&quot;&gt;&lt;tr data-start=&quot;1606&quot; data-end=&quot;1625&quot;&gt;&lt;td data-start=&quot;1606&quot; data-end=&quot;1618&quot; data-col-size=&quot;sm&quot;&gt;GET /feed&lt;/td&gt;&lt;td data-start=&quot;1618&quot; data-end=&quot;1625&quot; data-col-size=&quot;sm&quot;&gt;70%&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1626&quot; data-end=&quot;1646&quot;&gt;&lt;td data-start=&quot;1626&quot; data-end=&quot;1639&quot; data-col-size=&quot;sm&quot;&gt;POST /like&lt;/td&gt;&lt;td data-start=&quot;1639&quot; data-end=&quot;1646&quot; data-col-size=&quot;sm&quot;&gt;15%&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1647&quot; data-end=&quot;1670&quot;&gt;&lt;td data-start=&quot;1647&quot; data-end=&quot;1663&quot; data-col-size=&quot;sm&quot;&gt;POST /comment&lt;/td&gt;&lt;td data-start=&quot;1663&quot; data-end=&quot;1670&quot; data-col-size=&quot;sm&quot;&gt;10%&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1671&quot; data-end=&quot;1692&quot;&gt;&lt;td data-start=&quot;1671&quot; data-end=&quot;1686&quot; data-col-size=&quot;sm&quot;&gt;POST /upload&lt;/td&gt;&lt;td data-start=&quot;1686&quot; data-end=&quot;1692&quot; data-col-size=&quot;sm&quot;&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
